App(
    appid="bt",
    name="BtSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="bt_srv",
    cdefines=["SRV_BT"],
    requires=[
        "cli",
        "dialogs",
    ],
    provides=[
        "bt_start",
        "bt_settings",
        "ams_cli_start",
    ],
    stack_size=1 * 1024,
    order=20,
    sdk_headers=["bt_service/bt.h", "bt_service/bt_keys_storage.h"],
)

App(
    appid="bt_start",
    apptype=FlipperAppType.STARTUP,
    entry_point="bt_on_system_start",
    order=40,
)

App(
    appid="ams_cli_start",
    apptype=FlipperAppType.STARTUP,
    entry_point="ams_cli_on_system_start",
    requires=["bt"],
    order=65,
)
